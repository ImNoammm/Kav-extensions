  "minKav": 47,
  "api": 4,
  "issues": "https://github.com/ImNoammm/kav-extensions/issues",
  "description": "A little bus that lives on top of Kav's tab bar: it walks, sits, naps, hops when you tap it, and goes where you carry it.",
  "native": { "dex": "classes.dex", "entry": "kav.kavapp.examples.shimeji.Shimeji" },
  "contributions": [
    { "id": "buddy", "capability": "part.tabbar" }
  ],
  "reasons": {
    "parts": { "en": "A little bus that walks along the top of the tab bar", "he": "אוטובוס קטן שמטייל על סרגל הלשוניות" }
