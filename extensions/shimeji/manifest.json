  "settings": [
    { "key": "size", "type": "choice", "label": { "en": "Size", "he": "גודל" }, "default": "medium",
      "options": [
        { "value": "small", "label": { "en": "Small", "he": "קטן" } },
        { "value": "medium", "label": { "en": "Medium", "he": "בינוני" } },
        { "value": "large", "label": { "en": "Large", "he": "גדול" } }
      ] },
    { "key": "where", "type": "choice", "label": { "en": "Shows on", "he": "איפה הוא מופיע" }, "default": "all",
      "options": [
        { "value": "all", "label": { "en": "Every tab", "he": "בכל הלשוניות" } },
        { "value": "home", "label": { "en": "Home only", "he": "רק בבית" } }
      ] },
    { "key": "naps", "type": "toggle", "label": { "en": "Naps when left alone", "he": "נרדם כשלא נוגעים בו" }, "default": true }
  ]
