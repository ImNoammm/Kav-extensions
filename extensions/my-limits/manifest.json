{
  "format": 1,
  "name": "my-limits",
  "displayName": "My limits",
  "version": "1.1.1",
  "release": 3,
  "minKav": 45,
  "api": 2,
  "issues": "https://github.com/ImNoammm/kav-extensions/issues",
  "description": "Hides routes with more changes or a longer walk than you set, and says why. Tags night rides.",
  "native": { "dex": "classes.dex", "entry": "kav.kavapp.examples.mylimits.MyLimits" },
  "contributions": [
    { "id": "limits", "capability": "results.filter" },
    { "id": "tags", "capability": "results.annotate" }
  ],
  "tags": {
    "night": { "en": "Night ride", "he": "נסיעת לילה" }
  },
  "reasons": {
    "results.filter": { "en": "Hides a route with more changes or a longer walk than you set", "he": "מסתיר מסלול עם יותר החלפות או הליכה ארוכה יותר ממה שהגדרתם" },
    "results.annotate": { "en": "Tags rides between 23:00 and 05:00", "he": "מתייג נסיעות בין 23:00 ל-05:00" }
  },
  "settings": [
    { "key": "changes", "type": "number", "label": { "en": "Most changes", "he": "הכי הרבה החלפות" }, "min": 0, "max": 4, "default": 2 },
    { "key": "walk", "type": "number", "label": { "en": "Longest walk", "he": "ההליכה הארוכה ביותר" }, "min": 1, "max": 40, "default": 15, "unit": { "en": "min", "he": "דק׳" } },
    { "key": "night", "type": "toggle", "label": { "en": "Tag night rides", "he": "תיוג נסיעות לילה" }, "default": true }
  ]
}
