{
  "format": 1,
  "name": "notebook",
  "displayName": "Notebook",
  "version": "1.0.2",
  "release": 3,
  "minKav": 45,
  "api": 3,
  "issues": "https://github.com/ImNoammm/kav-extensions/issues",
  "description": "A tab of its own for short notes: a stop code, a line to remember, a platform. Kept on your phone only.",
  "native": { "dex": "classes.dex", "entry": "kav.kavapp.examples.notebook.Notebook" },
  "contributions": [
    { "id": "screens", "capability": "page.provide" }
  ],
  "pages": [
    { "id": "notes", "title": { "en": "Notes", "he": "פתקים" }, "tab": true }
  ],
  "reasons": {
    "page.provide": { "en": "A screen with your notes, which you can show as a tab", "he": "מסך עם הפתקים שלכם, שאפשר להציג כלשונית" }
  },
  "settings": [
    { "key": "newest", "type": "toggle", "label": { "en": "Newest notes first", "he": "הפתקים החדשים קודם" }, "default": true }
  ]
}
